{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hn-stremio",
  "main": "src/index.js",
  "account_id": "97e81ed3ee42a3392a345c91c465ab96",
  "compatibility_date": "2026-10-27",
  "routes": [{ "pattern": "hn-stremio.alen.ro", "custom_domain": true }],
  "ai": { "binding": "AI" },
  "d1_databases": [{ "binding": "DB", "database_name": "hn-stremio", "database_id": "ca54a617-ad35-4a22-ad0c-76d29e6431af" }],
  // Read new HN comments once a day. History is backfilled locally with scripts/backfill.mjs.
  "triggers": { "crons": ["0 6 * * *"] },
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "vars": {
    // Extracts titles from plain-text comments. Needs JSON mode support.
    "MODEL": "@cf/openai/gpt-oss-120b",
    "LLM_CALLS_PER_RUN": "30",   // 20 comments per call, ~15s each
    "LLM_CONCURRENCY": "3",      // LLM calls in flight at once
    "LOOKUPS_PER_RUN": "300",    // Cinemeta / Wikipedia requests per run
    "RECENT_DAYS": "60"          // window for the "Talked About Now" rows
  },
  "observability": { "enabled": true }
}
