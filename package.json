{
  "name": "hn-stremio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "db:init": "wrangler d1 execute hn-stremio --remote --file schema.sql",
    "db:seed": "wrangler d1 execute hn-stremio --remote --file seed/links.sql",
    "seed:build": "node scripts/backfill-links.mjs data/local.sqlite && node scripts/export-sql.mjs data/local.sqlite > seed/links.sql"
  },
  "devDependencies": {
    "wrangler": "^4.157.0"
  }
}
